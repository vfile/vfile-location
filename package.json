{
  "author": "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)",
  "bugs": "https://github.com/vfile/vfile-location/issues",
  "contributors": [
    "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)",
    "Christian Murphy <christian.murphy.42@gmail.com>"
  ],
  "dependencies": {
    "@types/unist": "^3.0.0",
    "vfile": "^6.0.0"
  },
  "description": "vfile utility to convert between positional (line and column-based) and offsets (range-based) locations",
  "devDependencies": {
    "@types/node": "^26.0.0",
    "c8": "^12.0.0",
    "prettier": "^3.0.0",
    "remark-api": "^1.0.0",
    "remark-cli": "^12.0.0",
    "remark-preset-wooorm": "^11.0.0",
    "type-coverage": "^2.0.0",
    "typescript": "^6.0.0",
    "xo": "^5.0.0"
  },
  "exports": {
    "types": "./index.d.ts",
    "default": "./index.js"
  },
  "files": [
    "lib/",
    "index.d.ts",
    "index.js"
  ],
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/unified"
  },
  "keywords": [
    "file",
    "location",
    "offset",
    "point",
    "position",
    "utility",
    "util",
    "vfile-util",
    "vfile",
    "virtual"
  ],
  "license": "MIT",
  "name": "vfile-location",
  "prettier": {
    "bracketSpacing": false,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-wooorm",
      "remark-api"
    ]
  },
  "repository": "vfile/vfile-location",
  "scripts": {
    "build": "tsc --build --clean && tsc --build && type-coverage",
    "format": "remark --frail --output --quiet -- . && prettier --log-level warn --write -- . && xo --fix",
    "prepack": "npm run build && npm run format",
    "test-api": "node --conditions development test.js",
    "test-coverage": "c8 --100 --reporter lcov -- npm run test-api",
    "test": "npm run build && npm run format && npm run test-coverage"
  },
  "sideEffects": false,
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "type": "module",
  "version": "5.0.4"
}
